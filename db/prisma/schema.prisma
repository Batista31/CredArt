generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [uuidOssp(map: "uuid-ossp"), vector]
}

model Card {
  id             String   @id @db.VarChar(64)
  bankName       String   @map("bank_name") @db.VarChar(64)
  cardName       String   @map("card_name") @db.VarChar(128)
  cardTier       String   @map("card_tier") @db.VarChar(32)
  network        String   @db.VarChar(16)
  annualFeeInr   Int      @default(0) @map("annual_fee_inr")
  baseEarnRate   Decimal  @map("base_earn_rate") @db.Decimal(6, 2)
  currencyName   String   @map("currency_name") @db.VarChar(32)
  imageAssetUrl  String?  @map("image_asset_url") @db.Text
  cardPageUrl    String   @map("card_page_url") @db.Text
  joiningFeeInr      Int?      @map("joining_fee_inr")
  pointsExpiryMonths Int?      @map("points_expiry_months")
  excludedCategories String[]  @map("excluded_categories")
  blackoutDates      String[]  @map("blackout_dates")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz
  benefits        Benefit[]
  transferPartners TransferPartner[]
  tncVersions     TncVersion[]
  userCards       UserCard[]
  scraperRuns     ScraperRun[]
  benefitEmbeddings BenefitEmbedding[]
  @@map("cards")
}

model Benefit {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cardId        String    @map("card_id") @db.VarChar(64)
  category      String    @db.VarChar(64)
  sortOrder     Int       @default(0) @map("sort_order")
  benefitName   String    @map("benefit_name") @db.VarChar(256)
  description   String    @db.Text
  benefitType   String    @map("benefit_type") @db.VarChar(32)
  pointsCost            Int?  @map("points_cost")
  cashComponentInr     Int?  @map("cash_component_inr")
  milestoneThresholdInr Int? @map("milestone_threshold_inr")
  sourceUrl     String    @map("source_url") @db.Text
  verified      Boolean   @default(true)
  contentHash   String    @map("content_hash") @db.VarChar(64)
  effectiveDate DateTime? @map("effective_date") @db.Date
  tncUpdatedAt  DateTime? @map("tnc_updated_at") @db.Timestamptz
  isEmbedded    Boolean   @default(false) @map("is_embedded")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  card              Card               @relation(fields: [cardId], references: [id], onDelete: Cascade)
  benefitEmbeddings BenefitEmbedding[]
  @@index([cardId])
  @@index([cardId, category], name: "idx_benefits_card_category")
  @@index([benefitType])
  @@map("benefits")
}

model TransferPartner {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cardId              String    @map("card_id") @db.VarChar(64)
  partnerName         String    @map("partner_name") @db.VarChar(128)
  partnerProgramme    String?   @map("partner_programme") @db.VarChar(128)
  partnerType         String    @map("partner_type") @db.VarChar(32)
  sourcePoints        Int       @map("source_points")
  destinationPoints   Int       @map("destination_points")
  minimumTransfer     Int       @default(1000) @map("minimum_transfer")
  processingDaysMin   Int       @default(3) @map("processing_days_min")
  processingDaysMax   Int       @default(5) @map("processing_days_max")
  reversible          Boolean   @default(false)
  effectiveValueInr   Decimal?  @map("effective_value_inr") @db.Decimal(8, 4)
  bestUseCase         String?   @map("best_use_case") @db.Text
  sourceUrl           String    @map("source_url") @db.Text
  isActive            Boolean   @default(true) @map("is_active")
  contentHash         String    @map("content_hash") @db.VarChar(64)
  effectiveDate       DateTime? @map("effective_date") @db.Date
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  card               Card                @relation(fields: [cardId], references: [id], onDelete: Cascade)
  redemptionHistory  RedemptionHistory[]
  @@index([cardId])
  @@index([partnerType])
  @@map("transfer_partners")
}

model TncVersion {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cardId           String    @map("card_id") @db.VarChar(64)
  pdfUrl           String    @map("pdf_url") @db.Text
  pdfHash          String    @map("pdf_hash") @db.VarChar(64)
  effectiveDate    DateTime  @map("effective_date") @db.Date
  detectedAt       DateTime  @default(now()) @map("detected_at") @db.Timestamptz
  ingestionStatus  String    @default("pending") @map("ingestion_status") @db.VarChar(32)
  ingestedAt       DateTime? @map("ingested_at") @db.Timestamptz
  isCurrent        Boolean   @default(false) @map("is_current")
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  @@index([cardId, isCurrent], name: "idx_tnc_card_current")
  @@map("tnc_versions")
}

model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(128)
  email     String   @unique @db.VarChar(256)
  phone     String?  @db.VarChar(16)
  city      String?  @db.VarChar(64)
  state     String?  @db.VarChar(64)
  country   String   @default("India") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  userCards            UserCard[]
  preferences          Preference?
  redemptionHistory    RedemptionHistory[]
  recommendationEvents RecommendationEvent[]
  smsMessages          SmsMessage[]
  conversations        Conversation[]
  userMemory           UserMemory?
  savedAddresses       UserSavedAddress[]
  unfinishedTasks      UnfinishedTask[]
  recommendationSessions RecommendationSession[]
  redemptionOrders     RedemptionOrder[]
  profileSignals       ProfileSignal[]
  @@map("users")
}

model UserCard {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  cardId             String    @map("card_id") @db.VarChar(64)
  cardNumberMasked   String    @map("card_number_masked") @db.VarChar(20)
  expiryMonth        Int       @map("expiry_month") @db.SmallInt
  expiryYear         Int       @map("expiry_year") @db.SmallInt
  currentPoints      Int       @default(0) @map("current_points")
  demoPoints         Int       @default(100000) @map("demo_points")
  nextExpiryPoints   Int?      @map("next_expiry_points")
  nextExpiryDate     DateTime? @map("next_expiry_date") @db.Date
  tierLevel          String    @default("standard") @map("tier_level") @db.VarChar(32)
  annualFeePaid      Boolean   @default(false) @map("annual_fee_paid")
  annualFeePaidDate  DateTime? @map("annual_fee_paid_date") @db.Date
  isPrimary          Boolean   @default(false) @map("is_primary")
  isActive           Boolean   @default(true) @map("is_active")
  joinedAt           DateTime  @map("joined_at") @db.Date
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  card              Card                @relation(fields: [cardId], references: [id])
  pointsLedger      PointsLedger[]
  redemptionHistory RedemptionHistory[]
  smsMessages       SmsMessage[]
  @@unique([userId, cardId])
  @@index([userId])
  @@index([cardId])
  @@map("user_cards")
}

model PointsLedger {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userCardId      String    @map("user_card_id") @db.Uuid
  transactionType String    @map("transaction_type") @db.VarChar(32)
  pointsDelta     Int       @map("points_delta")
  balanceAfter    Int       @map("balance_after")
  description     String?   @db.Text
  referenceId     String?   @map("reference_id") @db.Uuid
  expiryDate      DateTime? @map("expiry_date") @db.Date
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  userCard UserCard @relation(fields: [userCardId], references: [id], onDelete: Cascade)
  @@index([userCardId])
  @@index([createdAt(sort: Desc)])
  @@index([expiryDate])
  @@map("points_ledger")
}

model Preference {
  id                         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                     String    @unique @map("user_id") @db.Uuid
  destinationType            String?   @map("destination_type") @db.VarChar(32)
  tripLength                 String?   @map("trip_length") @db.VarChar(16)
  regionPreference           String?   @map("region_preference") @db.VarChar(32)
  accommodationTier          String?   @map("accommodation_tier") @db.VarChar(16)
  flightPreference           String?   @map("flight_preference") @db.VarChar(16)
  departurePreference        String?   @map("departure_preference") @db.VarChar(16)
  travelWeight               Decimal   @default(0.400) @map("travel_weight") @db.Decimal(4, 3)
  diningWeight               Decimal   @default(0.200) @map("dining_weight") @db.Decimal(4, 3)
  shoppingWeight             Decimal   @default(0.200) @map("shopping_weight") @db.Decimal(4, 3)
  cashbackWeight             Decimal   @default(0.100) @map("cashback_weight") @db.Decimal(4, 3)
  experiencesWeight          Decimal   @default(0.100) @map("experiences_weight") @db.Decimal(4, 3)
  valueSensitivityThreshold  Decimal?  @map("value_sensitivity_threshold") @db.Decimal(6, 4)
  totalRedemptions           Int       @default(0) @map("total_redemptions")
  totalDismissals            Int       @default(0) @map("total_dismissals")
  updatedAt                  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("preferences")
}

model RedemptionHistory {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                 String    @map("user_id") @db.Uuid
  userCardId             String    @map("user_card_id") @db.Uuid
  transactionId          String    @unique @map("transaction_id") @db.VarChar(64)
  status                 String    @db.VarChar(32)
  optionType             String    @map("option_type") @db.VarChar(32)
  optionLabel            String    @map("option_label") @db.Text
  pointsUsed             Int       @default(0) @map("points_used")
  cashUsedInr            Decimal   @default(0) @map("cash_used_inr") @db.Decimal(10, 2)
  valueInr               Decimal   @map("value_inr") @db.Decimal(10, 2)
  partnerName            String?   @map("partner_name") @db.VarChar(128)
  transferPartnerId      String?   @map("transfer_partner_id") @db.Uuid
  confirmationReference  String?   @map("confirmation_reference") @db.Text
  rollbackReason         String?   @map("rollback_reason") @db.Text
  sourceUrls             Json?     @map("source_urls")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz
  completedAt            DateTime? @map("completed_at") @db.Timestamptz
  user            User             @relation(fields: [userId], references: [id])
  userCard        UserCard         @relation(fields: [userCardId], references: [id])
  transferPartner TransferPartner? @relation(fields: [transferPartnerId], references: [id])
  @@index([userId])
  @@index([status])
  @@index([transactionId])
  @@map("redemption_history")
}

model RecommendationEvent {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  sessionId            String   @map("session_id") @db.VarChar(64)
  recommendationRank   Int      @map("recommendation_rank") @db.SmallInt
  optionType           String   @map("option_type") @db.VarChar(32)
  optionLabel          String   @map("option_label") @db.Text
  scoreFinancial       Decimal? @map("score_financial") @db.Decimal(5, 2)
  scoreLifestyle       Decimal? @map("score_lifestyle") @db.Decimal(5, 2)
  scoreRedemptionProb  Decimal? @map("score_redemption_prob") @db.Decimal(5, 2)
  scoreExpiryRisk      Decimal? @map("score_expiry_risk") @db.Decimal(5, 2)
  scoreFlexibility     Decimal? @map("score_flexibility") @db.Decimal(5, 2)
  scoreTotal           Decimal? @map("score_total") @db.Decimal(5, 2)
  weightFinancial      Decimal? @map("weight_financial") @db.Decimal(4, 3)
  weightLifestyle      Decimal? @map("weight_lifestyle") @db.Decimal(4, 3)
  weightRedemptionProb Decimal? @map("weight_redemption_prob") @db.Decimal(4, 3)
  weightExpiryRisk     Decimal? @map("weight_expiry_risk") @db.Decimal(4, 3)
  weightFlexibility    Decimal? @map("weight_flexibility") @db.Decimal(4, 3)
  userAction           String?  @map("user_action") @db.VarChar(32)
  sourceUrls           Json?    @map("source_urls")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  user User @relation(fields: [userId], references: [id])
  @@index([userId])
  @@index([userAction])
  @@map("recommendation_events")
}

model Conversation {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  title       String    @db.VarChar(160)
  status      String    @default("active") @db.VarChar(32)
  journeyType String?   @map("journey_type") @db.VarChar(64)
  lastMessageAt DateTime @default(now()) @map("last_message_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    ConversationMessage[]
  state       ConversationState?
  unfinishedTasks UnfinishedTask[]
  recommendationSessions RecommendationSession[]
  redemptionOrders RedemptionOrder[]
  @@index([userId, updatedAt(sort: Desc)])
  @@map("conversations")
}

model ConversationMessage {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  role           String    @db.VarChar(16)
  content        String    @db.Text
  metadata       Json?     @db.JsonB
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([conversationId, createdAt])
  @@map("conversation_messages")
}

model ConversationState {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String    @unique @map("conversation_id") @db.Uuid
  journeyType    String?   @map("journey_type") @db.VarChar(64)
  responseType   String?   @map("response_type") @db.VarChar(32)
  knownSlots     Json      @default("{}") @db.JsonB
  missingSlots   Json      @default("[]") @db.JsonB
  openTask       String?   @map("open_task") @db.Text
  recommendationState Json? @map("recommendation_state") @db.JsonB
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@map("conversation_states")
}

model UserMemory {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String    @unique @map("user_id") @db.Uuid
  summary              String?   @db.Text
  structuredPreferences Json     @default("{}") @map("structured_preferences") @db.JsonB
  lifestyleTags        String[]  @default([])
  lastActiveConversationId String? @map("last_active_conversation_id") @db.Uuid
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("user_memory")
}

model UserSavedAddress {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  label       String    @db.VarChar(64)
  line1       String    @db.VarChar(160)
  line2       String?   @db.VarChar(160)
  city        String    @db.VarChar(64)
  state       String    @db.VarChar(64)
  postalCode  String    @map("postal_code") @db.VarChar(16)
  country     String    @default("India") @db.VarChar(64)
  isDefault   Boolean   @default(false) @map("is_default")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  redemptionOrders RedemptionOrder[]
  @@index([userId, isDefault])
  @@map("user_saved_addresses")
}

model UnfinishedTask {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  journeyType    String    @map("journey_type") @db.VarChar(64)
  title          String    @db.VarChar(160)
  status         String    @default("open") @db.VarChar(32)
  details        Json      @default("{}") @db.JsonB
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([userId, status, updatedAt(sort: Desc)])
  @@map("unfinished_tasks")
}

model RecommendationSession {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  conversationId String?   @map("conversation_id") @db.Uuid
  journeyType    String    @map("journey_type") @db.VarChar(64)
  status         String    @default("draft") @db.VarChar(32)
  inputContext   Json      @default("{}") @map("input_context") @db.JsonB
  recommendations Json     @default("[]") @db.JsonB
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  redemptionOrders RedemptionOrder[]
  @@index([userId, createdAt(sort: Desc)])
  @@map("recommendation_sessions")
}

model RewardItem {
  id              String    @id @db.VarChar(64)
  catalogueName   String    @map("catalogue_name") @db.VarChar(64)
  title           String    @db.VarChar(160)
  description     String    @db.Text
  category        String    @db.VarChar(64)
  subcategory     String?   @db.VarChar(64)
  brand           String?   @db.VarChar(64)
  provider        String?   @db.VarChar(64)
  pointsPrice     Int       @map("points_price")
  cashPriceInr    Int?      @map("cash_price_inr")
  pointsPlusCash  Json?     @map("points_plus_cash") @db.JsonB
  inventoryStatus String    @default("in_stock") @map("inventory_status") @db.VarChar(32)
  fulfillmentType String    @default("delivery") @map("fulfillment_type") @db.VarChar(32)
  metadata        Json?     @db.JsonB
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  redemptionOrders RedemptionOrder[]
  @@index([category, isActive])
  @@map("reward_items")
}

model RedemptionOrder {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                  String    @map("user_id") @db.Uuid
  conversationId          String?   @map("conversation_id") @db.Uuid
  recommendationSessionId String?   @map("recommendation_session_id") @db.Uuid
  itemType                String    @map("item_type") @db.VarChar(32)
  itemId                  String    @map("item_id") @db.VarChar(64)
  pointsUsed              Int       @default(0) @map("points_used")
  cashComponent           Decimal   @default(0) @map("cash_component") @db.Decimal(10, 2)
  status                  String    @default("pending_confirmation") @db.VarChar(32)
  deliveryAddressId       String?   @map("delivery_address_id") @db.Uuid
  confirmationTimestamp   DateTime? @map("confirmation_timestamp") @db.Timestamptz
  providerReference       String?   @map("provider_reference") @db.Text
  details                 Json?     @db.JsonB
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation            Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  recommendationSession   RecommendationSession? @relation(fields: [recommendationSessionId], references: [id], onDelete: SetNull)
  deliveryAddress         UserSavedAddress? @relation(fields: [deliveryAddressId], references: [id], onDelete: SetNull)
  rewardItem              RewardItem  @relation(fields: [itemId], references: [id])
  @@index([userId, createdAt(sort: Desc)])
  @@map("redemption_orders")
}

model ProfileSignal {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  source      String    @db.VarChar(32)
  signalType  String    @map("signal_type") @db.VarChar(64)
  signalKey   String    @map("signal_key") @db.VarChar(64)
  signalValue Json      @map("signal_value") @db.JsonB
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, source, signalType])
  @@map("profile_signals")
}

model BenefitEmbedding {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  benefitId     String    @map("benefit_id") @db.Uuid
  cardId        String    @map("card_id") @db.VarChar(64)
  category      String    @db.VarChar(64)
  chunkText     String    @map("chunk_text") @db.Text
  sourceUrl     String    @map("source_url") @db.Text
  contentHash   String    @map("content_hash") @db.VarChar(64)
  effectiveDate DateTime? @map("effective_date") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  benefit Benefit @relation(fields: [benefitId], references: [id], onDelete: Cascade)
  card    Card    @relation(fields: [cardId], references: [id])
  @@index([cardId])
  @@map("benefit_embeddings")
}

model SmsMessage {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  userCardId   String?   @map("user_card_id") @db.Uuid
  smsHash      String    @unique @map("sms_hash") @db.VarChar(64)
  sender       String?   @db.VarChar(32)
  smsType      String    @map("sms_type") @db.VarChar(32)
  cardLast4    String?   @map("card_last4") @db.VarChar(4)
  rawText      String    @map("raw_text") @db.Text
  parsed       Json?     @db.JsonB
  applied      Boolean   @default(false)
  errorMessage String?   @map("error_message") @db.Text
  receivedAt   DateTime  @default(now()) @map("received_at") @db.Timestamptz
  processedAt  DateTime  @default(now()) @map("processed_at") @db.Timestamptz
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userCard UserCard? @relation(fields: [userCardId], references: [id])
  @@index([userId])
  @@index([userCardId])
  @@map("sms_messages")
}

model ScraperRun {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cardId             String    @map("card_id") @db.VarChar(64)
  runType            String    @map("run_type") @db.VarChar(32)
  status             String    @db.VarChar(32)
  previousHash       String?   @map("previous_hash") @db.VarChar(64)
  newHash            String?   @map("new_hash") @db.VarChar(64)
  pagesScraped       Int       @default(0) @map("pages_scraped")
  benefitsUpserted   Int       @default(0) @map("benefits_upserted")
  errorMessage       String?   @map("error_message") @db.Text
  triggeredBy        String    @default("schedule") @map("triggered_by") @db.VarChar(32)
  startedAt          DateTime  @default(now()) @map("started_at") @db.Timestamptz
  completedAt        DateTime? @map("completed_at") @db.Timestamptz
  card Card @relation(fields: [cardId], references: [id])
  @@index([cardId, startedAt(sort: Desc)], name: "idx_scraper_card_started")
  @@map("scraper_runs")
}
