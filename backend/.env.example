# CredArt backend — environment variables (copy to .env and fill in).
# Everything is optional for the demo: services degrade gracefully when a key
# is missing (in-process fallbacks, template replies, hardcoded catalogues).

# --- Database (Supabase Postgres) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Embeddings (optional; OpenAI else a local fallback) ---
OPENAI_API_KEY=

# --- LLM: Groq primary (rotate keys), Gemini fallback ---
# GROQ_API_KEY_2/_3 are optional extra keys; a rate-limited key rotates to the next.
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GEMINI_API_KEY=

# --- Sessions / locks (optional; in-memory fallback when unset) ---
REDIS_URL=

# --- Bank MCP server (:8000) ---
# The backend is a CLIENT of the mock HDFC bank MCP server. When the server is
# running the backend sources card-level catalogue/T&C over MCP; otherwise it
# transparently falls back to the in-process Layer-1 services. The client already
# defaults to this URL, so this line is only needed to point at a different host.
BANK_MCP_URL=http://127.0.0.1:8000/sse

# --- Mock hotel storefront (:8002) ---
# Live "assisted" hotel booking target (backend/storefront/app.py). With these set,
# hotel candidates surface as bookable and a redemption POSTs a real reservation to
# the storefront; unset, hotels are listed but marked "storefront URL not configured".
PROVIDER_HOTEL_INDRAPRASTHA_BOOK_URL=http://127.0.0.1:8002/api/book
PROVIDER_HOTEL_COUNTRY_INN_BOOK_URL=http://127.0.0.1:8002/api/book

# --- Fulfilment partners (production mode only; demo mode never calls these) ---
DUFFEL_API_KEY=
TANGO_API_USER=
TANGO_API_PASS=

# --- Entertainment concierge (/entertainment) ---
# TMDB "now playing" movies (real titles, posters, ratings). Free: create an
# account at https://www.themoviedb.org/, then go to Settings → API and copy the
# "API Key (v3 auth)". Without it the entertainment router falls back gracefully
# to a small set of hardcoded movie titles.
TMDB_API_KEY=
